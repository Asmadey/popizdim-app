OPENROUTER_API_KEY=
# Azure Foundry resource with a MAI-Transcribe-2-Streaming deployment.
AZURE_MAI_ENDPOINT=https://my-resource.services.ai.azure.com
AZURE_MAI_API_KEY=
AZURE_MAI_DEPLOYMENT_NAME=MAI-Transcribe-2-Streaming
